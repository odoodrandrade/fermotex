<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherith" model="ir.ui.view">
            <field name="name">stock.picking.form.inherith</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="replace">
                     <button name="action_report_delivery"  string="Print" attrs="{'invisible': [('state', '!=', 'done')]}" type="object" groups="base.group_user" data-hotkey="o"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>